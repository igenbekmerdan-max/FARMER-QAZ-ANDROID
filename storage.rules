rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /farms/{farmId}/{folder}/{fileName} {
      allow read: if request.auth != null
        && firestore.exists(/databases/(default)/documents/farms/$(farmId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/farms/$(farmId)/members/$(request.auth.uid)).data.status == 'active';

      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/farms/$(farmId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/farms/$(farmId)/members/$(request.auth.uid)).data.status == 'active'
        && (folder in ['animals', 'task_proofs', 'vet_docs'])
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
  }
}
